{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"lib": ["ESNext"],
		"types": ["bun"],
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noUncheckedIndexedAccess": false,
		"noPropertyAccessFromIndexSignature": false,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@nowhere-team/tellme-sdk": ["./packages/sdk/src/index.ts"]
		}
	},
	"include": ["src/**/*", "packages/sdk/src/**/*", "packages/sdk/tests/**/*"],
	"exclude": ["node_modules", "dist", "packages/sdk/dist"]
}
