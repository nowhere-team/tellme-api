{
  "name": "tellme-api",
  "module": "./src/index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "types": "tsc --noEmit",
    "test": "bun run --cwd packages/sdk test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "lefthook install || echo 'lefthook not found'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/bun": "^1.3.11",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.5",
    "lint-staged": "^16.4.0",
    "pg": "^8.20.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "jose": "^6.2.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  }
}
